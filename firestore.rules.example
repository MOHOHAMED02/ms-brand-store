rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 👇 CHANGE to the shop owner's email (the admin login you create in Authentication)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ADMIN_EMAIL_HERE";
    }
    match /covers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      // Anyone can place an order, but only a valid new one
      allow create: if request.resource.data.status == "new"
        && request.resource.data.name is string && request.resource.data.name.size() < 100
        && request.resource.data.phone is string && request.resource.data.phone.size() < 30
        && request.resource.data.items is list && request.resource.data.items.size() > 0
        && request.resource.data.items.size() < 50;
      // Only the admin can see and update orders
      allow read, update, delete: if isAdmin();
    }
  }
}
